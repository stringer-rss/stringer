.git/*
.gitignore
log/*

# Built inside the image instead. Local copies would bloat the image or, for
# node_modules, clash with the platform-specific packages pnpm installs.
node_modules
app/assets/builds/*
public/assets
coverage
tmp/*

# Generated at runtime and mounted in by compose. A local copy baked into the
# image would be loaded by dotenv, silently overriding the intended config.
.env
.env.*.local
